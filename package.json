{
  "name": "project-orchestrator-service",
  "version": "0.1.0",
  "private": true,
  "description": "MCP service exposing plan-state read/update for majodali/project-orchestrator, on AWS Lambda / HTTP API / DynamoDB.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/model/cli.js', 0o755)\"",
    "prepare": "node scripts/prepare.mjs",
    "dev": "tsx src/localServer.ts",
    "view:preview": "tsx src/view/preview/preview.ts",
    "view:shots": "tsx src/view/preview/shots.ts",
    "bundle:lambda": "esbuild src/lambda.ts --bundle --platform=node --target=node22 --format=esm --banner:js=\"import { createRequire as __createRequire } from 'node:module'; const require = __createRequire(import.meta.url);\" --outfile=dist-lambda/lambda.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.3.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "sharp": "^0.35.5",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "esbuild": "^0.28.2",
    "hono": "^4.13.5",
    "universal-github-app-jwt": "^2.2.2",
    "zod": "^4.4.3"
  },
  "bin": {
    "plan-state": "dist/model/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
